+
+//
+// Z_TryMalloc
+// Pico2Doom: like Z_Malloc, but returns NULL when the zone cannot make
+// room, for allocations that are nice to have (the screen melt's buffer).
+// Purgeable blocks may still have been thrown out while it looked.
+//
+void *Z_TryMalloc (int size, int tag, void *user)
+{
+    void *result;
+
+    z_try_only = true;
+    result = Z_Malloc (size, tag, user);
+    z_try_only = false;
     return result;
 }
 
