+		                         | (1ull << 36) /*SBE*/ | (1ull << 37) /*MBE*/ | (1ull << 38) /*GVA*/
+		                         | (1ull << 39) /*MPV*/;
+		const uint64_t diff = csr[addr] ^ value;
+		csr[addr] = value;
+		if (diff & KEYED) state_gen++;
+		bump_event_gen();
+		if (csr_log) csr_log->push_back(addr);
+		return;
