+//
+// R_EnsureLookup
+// Pico2Doom: build a texture's column lookup on first use.
+//
+// Vanilla builds every texture's lookup at startup and keeps it: two shorts
+// per column of every texture, 64 KB for DOOM1.WAD, most of it for textures
+// the current level never shows. Here it is built the first time a texture
+// is drawn, as one block (lumps, then offsets) tagged PU_CACHE, so the zone
+// can throw it away under pressure and it is simply rebuilt when next used.
+//
+void R_EnsureLookup (int texnum)
+{
+    int width;
+    short *block;
+
+    if (texturecolumnlump[texnum] != NULL)
+	return;
+
+    width = textures[texnum]->width;
+    block = Z_Malloc (width * (sizeof(short) + sizeof(unsigned short)),
+		      PU_STATIC, &texturecolumnlump[texnum]);
+    texturecolumnofs[texnum] = (unsigned short *) (block + width);
+    R_GenerateLookup (texnum);       // its own Z_Malloc can't purge a PU_STATIC block
+    Z_ChangeTag (block, PU_CACHE);
+}
+
 
 
 
