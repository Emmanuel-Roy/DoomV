+/* DoomV: Venus driven directly, in this process, on the caller's thread --
+ * no render server, and no thread of the renderer's own (VKR_RENDERER_SYNC).
+ * Everything the guest can observe happens inside these calls, so the
+ * embedder decides when. */
+#include "venus/vkr_renderer.h"
+
+static struct vkr_renderer_callbacks doomv_venus_cbs;
+
+VIRGL_EXPORT bool
+virgl_doomv_venus_init(void (*retire_fence)(uint32_t ctx_id, uint32_t ring_idx, uint64_t fence_id))
+{
+   doomv_venus_cbs.debug_logger = NULL;
+   doomv_venus_cbs.retire_fence = retire_fence;
+   return vkr_renderer_init(VKR_RENDERER_SYNC, &doomv_venus_cbs);
+}
+
+VIRGL_EXPORT size_t
+virgl_doomv_venus_capset(void *capset)
+{
+   return vkr_get_capset(capset, 0);
+}
+
+VIRGL_EXPORT bool
+virgl_doomv_venus_create_context(uint32_t ctx_id, uint32_t ctx_flags, uint32_t nlen, const char *name)
+{
+   return vkr_renderer_create_context(ctx_id, ctx_flags, nlen, name);
+}
+
+VIRGL_EXPORT void
+virgl_doomv_venus_destroy_context(uint32_t ctx_id)
+{
+   vkr_renderer_destroy_context(ctx_id);
+}
+
+VIRGL_EXPORT bool
+virgl_doomv_venus_submit_cmd(uint32_t ctx_id, void *cmd, uint32_t size)
+{
+   return vkr_renderer_submit_cmd(ctx_id, cmd, size);
+}
+
+VIRGL_EXPORT bool
+virgl_doomv_venus_submit_fence(uint32_t ctx_id, uint32_t flags, uint32_t ring_idx, uint64_t fence_id)
+{
+   return vkr_renderer_submit_fence(ctx_id, flags, ring_idx, fence_id);
+}
+
+VIRGL_EXPORT bool
+virgl_doomv_venus_create_resource(uint32_t ctx_id, uint32_t res_id, uint64_t blob_id,
+                                  uint64_t blob_size, uint32_t blob_flags, uint32_t *out_map_info)
+{
+   enum virgl_resource_fd_type fd_type;
+   int fd = -1;
+   struct virgl_resource_vulkan_info vulkan_info;
+   return vkr_renderer_create_resource(ctx_id, res_id, blob_id, blob_size, blob_flags, &fd_type,
+                                       &fd, out_map_info, &vulkan_info);
+}
+
+VIRGL_EXPORT bool
+virgl_doomv_venus_map_resource(uint32_t ctx_id, uint32_t res_id, void **out_ptr, uint64_t *out_size)
+{
+   return vkr_renderer_map_resource(ctx_id, res_id, out_ptr, out_size);
+}
+
+VIRGL_EXPORT void
+virgl_doomv_venus_destroy_resource(uint32_t ctx_id, uint32_t res_id)
+{
+   vkr_renderer_destroy_resource(ctx_id, res_id);
+}
+
+VIRGL_EXPORT bool
+virgl_doomv_venus_step(void)
+{
+   return vkr_renderer_sync_step();
+}
