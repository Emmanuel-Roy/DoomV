+/* Set while a command run by vkr_ring_sync_run would have to wait for a
+ * virtqueue seqno that has not been submitted: the run stops before it. */
+static bool vkr_ring_sync_would_block;
+
+bool
+vkr_ring_sync_run(struct vkr_ring *ring)
+{
+   struct vkr_cs_decoder *dec = &ring->decoder;
+   bool progress = false;
+
+   if (vkr_cs_decoder_get_fatal(dec))
+      return false;
+
+   if (ring->sync_off == ring->sync_len) {
+      const uint32_t cmd_size = vkr_ring_load_tail(ring) - ring->buffer.cur;
+      if (!cmd_size)
+         return false;
+      if (cmd_size > ring->buffer.size) {
+         vkr_log("%s: cmd_size(%u) > ring->buffer.size(%u)", __func__, cmd_size,
+                 ring->buffer.size);
+         vkr_ring_set_status_bits(ring, VK_RING_STATUS_FATAL_BIT_MESA);
+         vkr_context_on_ring_fatal(ring->dispatch.data);
+         return false;
+      }
+      ring->sync_head = ring->buffer.cur;
+      vkr_ring_read_buffer(ring, ring->cmd, cmd_size);
+      ring->sync_off = 0;
+      ring->sync_len = cmd_size;
+   }
+
+   const uint8_t *start = (const uint8_t *)ring->cmd + ring->sync_off;
+   vkr_cs_decoder_set_buffer_stream(dec, start, ring->sync_len - ring->sync_off);
+   while (vkr_cs_decoder_has_command(dec)) {
+      const uint8_t *before = dec->cur;
+      vkr_ring_sync_would_block = false;
+      vn_dispatch_command(&ring->dispatch);
+      if (vkr_ring_sync_would_block) {
+         /* run it again when the seqno arrives */
+         dec->cur = before;
+         break;
+      }
+      if (vkr_cs_decoder_get_fatal(dec)) {
+         vkr_log("%s: vn_dispatch_command failed", __func__);
+         vkr_ring_set_status_bits(ring, VK_RING_STATUS_FATAL_BIT_MESA);
+         vkr_context_on_ring_fatal(ring->dispatch.data);
+         break;
+      }
+      progress = true;
+      const uint32_t cur_ring_head =
+         ring->sync_head + ring->sync_off + (uint32_t)(dec->cur - start);
+      vkr_ring_store_head(ring, cur_ring_head);
+   }
+   ring->sync_off += (uint32_t)(dec->cur - start);
+   vkr_cs_decoder_reset(dec);
+   return progress;
+}
