+   struct vkr_resource *res = ctx ? vkr_context_get_resource(ctx, res_id) : NULL;
+   if (!res)
+      return false;
+   *out_ptr = res->fd_type == VIRGL_RESOURCE_FD_SHM ? (void *)res->u.data : res->sync_map;
+   *out_size = res->size;
+   return *out_ptr != NULL;
+}
