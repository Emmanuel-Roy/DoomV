+bool
+vkr_renderer_sync_step(void)
+{
+   /* Rings first, until none moves -- one can wait for a seqno another's
+    * commands submit -- then the GPU, so that everything submitted has
+    * finished and written what it writes before the guest runs again. */
+   bool ran = vkr_sync_dirty, progress;
+   do {
+      progress = false;
+      list_for_each_entry (struct vkr_context, ctx, &vkr_state.contexts, head) {
+         list_for_each_entry (struct vkr_ring, ring, &ctx->rings, head) {
+            if (ring->started && vkr_ring_sync_run(ring))
+               progress = true;
+         }
+      }
+      ran |= progress;
+   } while (progress);
+
+   /* only when something may have reached a queue: draining costs a
+    * round trip to the GPU, and the step runs often */
+   if (ran)
+      vkr_queue_sync_drain_all();
+   vkr_sync_dirty = false;
+
+   list_for_each_entry (struct vkr_context, ctx, &vkr_state.contexts, head) {
+      list_for_each_entry (struct vkr_ring, ring, &ctx->rings, head)
+         vkr_ring_sync_report(ring);
+   }
+   return ran;
+}
