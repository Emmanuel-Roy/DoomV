+// Another hart's CLINT registers, for a driver that runs several models
+// over one memory (a DoomV patch; see clint_remote_claim in
+// model/sys/platform.sail). `self` is the model making the access; `offset`
+// is from the CLINT base.
+class ClintRemote {
+public:
+  virtual ~ClintRemote() = default;
+  virtual bool claim(PlatformInterface &self, uint64_t offset, uint64_t width, bool store) = 0;
+  virtual uint64_t read(PlatformInterface &self, uint64_t offset, uint64_t width) = 0;
+  virtual void write(PlatformInterface &self, uint64_t offset, uint64_t width, uint64_t value) = 0;
+};
+
 class PlatformInterface {
 public:
+  // Unset, no access is claimed and the model is the single hart it was.
+  ClintRemote *clint_remote = nullptr;
+  bool clint_remote_claim(uint64_t offset, uint64_t width, bool store) {
+    return clint_remote != nullptr && clint_remote->claim(*this, offset, width, store);
+  }
+  uint64_t clint_remote_read(uint64_t offset, uint64_t width) {
+    return clint_remote->read(*this, offset, width);
+  }
+  unit clint_remote_write(uint64_t offset, uint64_t width, uint64_t value) {
+    clint_remote->write(*this, offset, width, value);
+    return UNIT;
+  }
+
   virtual unit fetch_callback(sbits opcode);
 
   virtual unit mem_write_callback(const char *type, sbits paddr, int64_t width, lbits value);
