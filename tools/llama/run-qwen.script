# Unattended: log in, mount the share, copy the binary in, run the model,
# power off. Fed to the emulator with -input=, gated on -expect="doomv login:"
# so the typing starts when the prompt appears rather than at a guessed time.
#
#   riscv_doom.exe -ng -ram=4G -opensbi=... -kernel=... -dtb=... \
#       -disk=ubuntu.img -drives= -shared=shared \
#       -expect="doomv login:" -input=tools/llama/run-qwen.script
#
# `sleep N` is N x 10,000 instructions, not wall-clock: the same script runs
# the same way on any host. The sleeps here are generous rather than tuned --
# the run ends when the guest powers itself off, so being early costs nothing
# and being late costs a wasted boot.
#
# Edit the model name and the prompt on the completion line.
sleep 20000
type root
key 28 1
key 28 0
sleep 30000
type doomv
key 28 1
key 28 0
sleep 75000
type mkdir -p /mnt/shared && mount -t 9p -o trans=virtio,version=9p2000.L shared /mnt/shared && cp /mnt/shared/llama /root/llama && chmod +x /root/llama && echo COPIED > /dev/hvc0
key 28 1
key 28 0
sleep 600000
type /root/llama version > /dev/hvc0 2>&1; echo VERSION-OK > /dev/hvc0
key 28 1
key 28 0
sleep 300000
type /root/llama completion -m /mnt/shared/Qwen3.5-0.8B-UD-IQ2_XXS.gguf -p "The capital of France is" -n 12 -t 1 --no-warmup > /dev/hvc0 2>&1; echo LLAMA-RUN-DONE > /dev/hvc0; echo o > /proc/sysrq-trigger
key 28 1
key 28 0
sleep 9000000
